PORT=8080
DATABASE_URL=postgres://divebubble:divebubble@localhost:5433/divebubble?sslmode=disable

# Both optional — default to ./uploads and http://localhost:$PORT. PUBLIC_BASE_URL must be
# reachable from whatever device/simulator is loading the image (not just the server host).
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8080

# Optional, comma-separated — only matters for browser clients (admin/, app/'s web build).
# Defaults to "*" (fine for local dev, Bearer-token auth has no cookie-credential risk).
# Set explicitly in production, e.g. https://admin.divebubble.io,https://divebubble.io
CORS_ALLOWED_ORIGINS=*

CENTRIFUGO_URL=http://localhost:8000
CENTRIFUGO_API_KEY=devkey
CENTRIFUGO_TOKEN_SECRET=devsecret

# Used by docker-compose.yml (postgres + migrate + centrifugo services)
POSTGRES_USER=divebubble
POSTGRES_PASSWORD=divebubble
POSTGRES_DB=divebubble
POSTGRES_PORT=5433
CENTRIFUGO_PORT=8000

# --- Production only (make deploy-up / docker-compose.prod.yml) ---
# Same variable names as above double as docker-compose.prod.yml's inputs — copy this file
# to .env on the droplet and replace every value below with a real one; docker-compose.prod.yml
# refuses to start if any ${VAR:?...} placeholder is left unset. See CLAUDE.md's Backend
# deploy section and nginx/api.divebubble.io.conf for what still needs setting up alongside this.
# POSTGRES_PASSWORD=<real password, not the dev default above>
# CENTRIFUGO_API_KEY=<real key, not "devkey">
# CENTRIFUGO_TOKEN_SECRET=<real secret, not "devsecret">
# JWT_SECRET=<real secret>
# GOOGLE_SERVER_CLIENT_ID=<same Web OAuth client id as dev>
# PUBLIC_BASE_URL=https://api.divebubble.io
# CORS_ALLOWED_ORIGINS=https://admin.divebubble.io,https://divebubble.io
# API_PORT=8081       — host-loopback port the shared droplet nginx proxies "/" to
# CENTRIFUGO_PORT=8090 — host-loopback port the shared droplet nginx proxies "/connection/websocket" to
