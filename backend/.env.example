PORT=8080
DATABASE_URL=postgres://divebubble:divebubble@localhost:5433/divebubble?sslmode=disable

# Both optional — default to ./uploads and http://localhost:$PORT. PUBLIC_BASE_URL must be
# reachable from whatever device/simulator is loading the image (not just the server host).
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8080

# Optional, comma-separated — only matters for browser clients (admin/, app/'s web build).
# Defaults to "*" (fine for local dev, Bearer-token auth has no cookie-credential risk).
# Set explicitly in production, e.g. https://admin.divebubble.io,https://divebubble.io
CORS_ALLOWED_ORIGINS=*

CENTRIFUGO_URL=http://localhost:8000
CENTRIFUGO_API_KEY=devkey
CENTRIFUGO_TOKEN_SECRET=devsecret

# Used by docker-compose.yml (postgres + migrate + centrifugo services)
POSTGRES_USER=divebubble
POSTGRES_PASSWORD=divebubble
POSTGRES_DB=divebubble
POSTGRES_PORT=5433
CENTRIFUGO_PORT=8000
